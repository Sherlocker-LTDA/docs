              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Obrigatorio. UUID unico por requisicao logica; reenviar a mesma chave com o mesmo body em ate 24h devolve a resposta original sem nova cobranca."
              }
            ],
            "body": {
              "mode": "raw",
