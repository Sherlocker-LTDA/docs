                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.id) {",
                  "  pm.collectionVariables.set('analysis_id', res.id);",
                  "  console.log('analysis_id =', res.id);",
                  "}"
                ]
              }
            }
