    {
      "name": "Motor de Bordero (CNAB 400)",
      "description": "Analise de uma operacao de desconto de duplicatas a partir de um arquivo CNAB 400. Assincrono: crie a operacao, faca polling em `GET /operations/{id}` a cada ~2s e, quando concluida, consulte `GET /operations/{id}/result`. Requer a feature `analysis_engine`.",
      "item": [
        {
          "name": "Criar operacao",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.operation_id) {",
                  "  pm.collectionVariables.set('operation_id', res.operation_id);",
                  "  console.log('operation_id =', res.operation_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Opcional. UUID unico por requisicao logica; reenviar a mesma chave com o mesmo body em ate 24h devolve a resposta original sem nova cobranca."
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Arquivo CNAB 400 remessa (.REM) — Banco Paulista 611, 444 colunas, Windows-1252. Obrigatorio. Maximo 128 MiB."
                },
                {
                  "key": "cedente_cnpj",
                  "value": "{{cedente_cnpj}}",
                  "type": "text",
                  "description": "CNPJ do cedente, 14 digitos ou formatado. Obrigatorio."
                },
                {
                  "key": "xmls",
                  "type": "file",
                  "src": [],
                  "description": "ZIP com os XMLs de NFe (nfeProc) dos titulos, para validacao cruzada. Opcional. Maximo 512 MiB; multipart completo maximo de 768 MiB no gateway.",
                  "disabled": true
                },
                {
                  "key": "engine_id",
                  "value": "template-padrao",
                  "type": "text",
                  "description": "ID da engine de bordero. Omitido ou \"template-padrao\": usa a engine template do sistema.",
                  "disabled": true
                },
                {
                  "key": "purpose",
                  "value": "",
                  "type": "text",
                  "description": "Finalidade da analise (auditoria LGPD). Opcional.",
                  "disabled": true
                },
                {
                  "key": "legal_basis",
                  "value": "",
                  "type": "text",
                  "description": "Base legal LGPD para os sacados PF. Opcional.",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/operations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "operations"
              ]
            },
            "description": "Cria uma operacao de bordero a partir de um arquivo CNAB 400. Selecione o arquivo `.REM` no campo `file` da aba Body. Retorna 202 com o `operation_id` (salvo automaticamente na variavel `operation_id`) e `status: queued`."
          },
          "response": []
        },
        {
          "name": "Consultar operacao",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/operations/{{operation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "operations",
