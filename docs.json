{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "appearance": {
    "default": "dark"
  },
  "name": "Sherlocker",
  "description": "Plataforma de inteligência investigativa - Documentação da API",
  "colors": {
    "primary": "#6C63FF",
    "light": "#F0EFFF",
    "dark": "#1A1A2E"
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://221b-api.sherlocker.com.br/api/v1",
    "auth": {
      "method": "key",
      "name": "token",
      "inputPrefix": ""
    },
    "playground": {
      "mode": "simple"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guias",
        "icon": "book",
        "groups": [
          {
            "group": "Início",
            "pages": [
              "introduction",
              "custos",
              "authentication",
              "guias/integracao-api",
              "padrao-de-dados",
              "cadastro/performance-acuracia",
              "guias/postman",
              "guias/mcp"
            ]
          },
          {
            "group": "Perfis",
            "pages": [
              "areas/contatos",
              "areas/patrimonio",
              "areas/juridico"
            ]
          },
          {
            "group": "Casos de Uso",
            "pages": [
              "casos-de-uso/background-check",
              "casos-de-uso/enriquecimento-leads",
              "casos-de-uso/segmentacao-patrimonial",
              "casos-de-uso/due-diligence",
              "casos-de-uso/levantamento-patrimonial",
              "casos-de-uso/localizacao-partes",
              "casos-de-uso/graus-de-conexao"
