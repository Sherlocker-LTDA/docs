{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "appearance": {
    "default": "dark"
  },
  "name": "Sherlocker",
  "description": "Plataforma de inteligência investigativa - Documentação da API",
  "colors": {
    "primary": "#6C63FF",
    "light": "#F0EFFF",
    "dark": "#1A1A2E"
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://221b-api.sherlocker.com.br/api/v1",
    "auth": {
      "method": "key",
      "name": "token",
      "inputPrefix": ""
    },
    "playground": {
      "mode": "simple"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guias",
        "icon": "book",
        "groups": [
          {
            "group": "Início",
            "pages": [
              "introduction",
              "custos",
              "authentication",
              "guias/integracao-api",
              "padrao-de-dados",
              "guias/postman",
              "guias/mcp"
            ]
          },
          {
            "group": "Perfis",
            "pages": [
              "areas/contatos",
              "areas/patrimonio",
              "areas/juridico"
            ]
          },
          {
            "group": "Casos de Uso",
            "pages": [
              "casos-de-uso/background-check",
              "casos-de-uso/enriquecimento-leads",
              "casos-de-uso/segmentacao-patrimonial",
              "casos-de-uso/due-diligence",
              "casos-de-uso/levantamento-patrimonial",
              "casos-de-uso/localizacao-partes",
              "casos-de-uso/graus-de-conexao"
            ]
          }
        ]
      },
      {
        "tab": "Cadastro",
        "icon": "users",
        "groups": [
          {
            "group": "Perfil Completo",
            "openapi": "/openapi/perfil.json",
            "pages": [
              "GET /perfil/cadastral/cpf/{cpf}",
              "GET /perfil/cadastral/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Entidades",
            "pages": [
              "entidades/pessoa",
              "entidades/empresa",
              "entidades/linha-do-tempo",
              "entidades/telefone",
              "entidades/email",
              "entidades/endereco",
              "entidades/divida",
              "entidades/beneficio",
              "entidades/licitacao"
            ]
          },
          {
            "group": "Pessoa Física",
            "openapi": "/openapi/pessoas.json",
            "pages": [
              "GET /pessoas/cpf/{cpf}",
              "GET /pessoas/cpf/{cpf}/enderecos",
              "GET /pessoas/cpf/{cpf}/empregos",
              "/openapi/empresas.json GET /empresas/cpf/{cpf}",
              "GET /pessoas/telefone/{telefone}",
              "GET /pessoas/email/{email}"
            ]
          },
          {
            "group": "Pessoa Jurídica",
            "openapi": "/openapi/empresas.json",
            "pages": [
              "GET /empresas/cnpj/{cnpj}",
              "GET /empresas/cnpj/{cnpj}/funcionarios",
              "GET /empresas/cnpj/{cnpj}/linha-do-tempo",
              "GET /empresas/codigos",
              "GET /empresas/telefone/{telefone}",
              "GET /empresas/email/{email}"
            ]
          },
          {
            "group": "Telefones & Emails",
            "openapi": "/openapi/pessoas.json",
            "pages": [
              "GET /telefones/cpf/{cpf}",
              "GET /telefones/cnpj/{cnpj}",
              "GET /emails/cpf/{cpf}",
              "GET /emails/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Dívidas",
            "openapi": "/openapi/dividas.json",
            "pages": [
              "GET /dividas/cpf/{cpf}",
              "GET /dividas/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Benefícios Sociais",
            "openapi": "/openapi/beneficios.json",
            "pages": [
              "GET /beneficios/cpf/{cpf}",
              "GET /beneficios/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Licitações",
            "openapi": "/openapi/licitacoes.json",
            "pages": [
              "GET /licitacoes/cpf/{cpf}",
              "GET /licitacoes/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Listas Restritivas",
            "openapi": "/openapi/listas-restritivas.json",
            "pages": [
              "GET /listas-restritivas/cpf/{cpf}",
              "GET /listas-restritivas/cnpj/{cnpj}",
              "GET /listas-restritivas/{documento}"
            ]
          }
        ]
      },
      {
        "tab": "Patrimônio",
        "icon": "landmark",
        "groups": [
          {
            "group": "Perfil Completo",
            "openapi": "/openapi/perfil.json",
            "pages": [
              "GET /perfil/patrimonial/cpf/{cpf}",
              "GET /perfil/patrimonial/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Entidades",
            "pages": [
              "entidades/propriedade-urbana",
              "entidades/propriedade-rural",
              "entidades/veiculo",
              "entidades/aeronave",
              "entidades/patente"
            ]
          },
          {
            "group": "Propriedades Urbanas",
            "openapi": "/openapi/imoveis.json",
            "pages": [
              "GET /imoveis/cpf/{cpf}",
              "GET /imoveis/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Propriedades Rurais",
            "openapi": "/openapi/rural.json",
            "pages": [
              "GET /rural/cpf/{cpf}",
              "GET /rural/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Veículos",
            "openapi": "/openapi/veiculos.json",
            "pages": [
              "GET /veiculos/cpf/{cpf}",
              "GET /veiculos/cnpj/{cnpj}",
              "GET /veiculos/placa/{placa}"
            ]
          },
          {
            "group": "Aeronaves",
            "openapi": "/openapi/aeronaves.json",
            "pages": [
              "GET /aeronaves/cpf/{cpf}",
              "GET /aeronaves/cnpj/{cnpj}"
            ]
          },
          {
            "group": "Patentes",
            "openapi": "/openapi/patentes.json",
            "pages": [
              "GET /patentes/cpf/{cpf}",
              "GET /patentes/cnpj/{cnpj}"
            ]
          }
        ]
      },
      {
        "tab": "Jurídico",
        "icon": "scale-balanced",
        "groups": [
          {
            "group": "Entidades",
            "pages": [
              "entidades/processo",
              "entidades/parte",
              "entidades/advogado",
              "entidades/documento"
            ]
          },
          {
            "group": "Processos",
            "openapi": "/openapi/processos.json",
            "pages": [
              "GET /processos/cpf/{cpf}",
              "GET /processos/cnpj/{cnpj}",
              "GET /processos/numero/{numero}",
              "GET /processos/numero/{numero}/movimentacoes",
              "GET /processos/categorias"
            ]
          },
          {
            "group": "Categorias",
            "pages": [
              "categorias/recuperacao-judicial",
              "categorias/falencia",
              "categorias/execucao-fiscal",
              "categorias/execucao-civel",
              "categorias/trabalhista",
              "categorias/criminal",
              "categorias/familia-sucessoes"
            ]
          },
          {
            "group": "Documentos Públicos",
            "openapi": "/openapi/documentos.json",
            "pages": [
              "GET /documentos/busca"
            ]
          }
        ]
      },
      {
        "tab": "Motor de Análise",
        "icon": "gauge-high",
        "groups": [
          {
            "group": "Começando",
            "pages": [
              "motor-analise/introducao",
              "motor-analise/quickstart",
              "motor-analise/autenticacao"
            ]
          },
          {
            "group": "Conceitos",
            "pages": [
              "motor-analise/ciclo-de-vida",
              "motor-analise/idempotencia",
              "motor-analise/cobranca",
              "motor-analise/engines"
            ]
          },
          {
            "group": "Referência",
            "pages": [
              "motor-analise/blocos",
              "motor-analise/erros"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "/openapi/motor-analise.json",
            "pages": [
              "POST /v1/analyses",
              "GET /v1/analyses/{id}"
            ]
          },
          {
            "group": "Códigos de erro",
            "pages": [
              "problems/validation_error",
              "problems/bad_request",
              "problems/unauthorized",
              "problems/insufficient_tokens",
              "problems/feature_not_enabled",
              "problems/forbidden",
              "problems/not_found",
              "problems/idempotency_conflict",
              "problems/no_engine",
              "problems/http_error",
              "problems/server_error"
            ]
          },
          {
            "group": "Acesso e suporte",
            "pages": [
              "api/access",
              "support"
            ]
          }
        ]
      },
      {
        "tab": "Motor de Crédito",
        "icon": "file-invoice-dollar",
        "groups": [
          {
            "group": "Começando",
            "pages": [
              "credito/introducao",
              "credito/quickstart",
              "credito/autenticacao"
            ]
          },
          {
            "group": "Conceitos",
            "pages": [
              "credito/ciclo-de-vida",
              "credito/idempotencia",
              "credito/cobranca",
              "credito/engines"
            ]
          },
          {
            "group": "Referência",
            "pages": [
              "credito/titulos-e-nfe",
              "credito/erros"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "/openapi/motor-credito.json",
            "pages": [
              "POST /v1/operations",
              "GET /v1/operations/{id}"
            ]
          },
          {
            "group": "Códigos de erro",
            "pages": [
              "credito/problems/validation_error",
              "credito/problems/bad_request",
              "credito/problems/unauthorized",
              "credito/problems/insufficient_tokens",
              "credito/problems/feature_not_enabled",
              "credito/problems/forbidden",
              "credito/problems/not_found",
              "credito/problems/idempotency_conflict",
              "credito/problems/no_engine",
              "credito/problems/http_error",
              "credito/problems/server_error"
            ]
          },
          {
            "group": "Acesso e suporte",
            "pages": [
              "credito/acesso",
              "credito/suporte"
            ]
          }
        ]
      }
    ]
  }
}
