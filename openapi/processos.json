    "/processos/numero/{numero}": {
      "get": {
        "operationId": "getProcessoByNumero",
        "summary": "Busca processo por numero",
        "description": "Retorna detalhes completos de um processo judicial pelo numero (com ou sem formatacao), incluindo valores mencionados, tags, eventos, audiencias, mandados, bens, identificadores, portes, partes e advogados. ATENCAO: as partes e advogados deste endpoint divergem da listagem por CPF/CNPJ — aqui `partes[].documento` pode ser null, `polo` vem em minusculas e `partes[].tipo` e o slug bruto (pessoa_fisica / pessoa_juridica). Este endpoint NAO retorna `movimentacoes` (use /processos/numero/{numero}/movimentacoes).",
        "tags": ["Processos"],
        "parameters": [
          {
            "name": "numero",
            "in": "path",
            "required": true,
            "description": "Numero do processo (com ou sem formatacao)",
            "schema": { "type": "string", "example": "0000001-23.2020.8.26.0100" }
          },
          {
            "name": "realtime",
            "in": "query",
            "required": false,
            "description": "Quando true, preserva a leitura atual da base e enfileira consulta no tribunal inferido do numero CNJ, quando houver scraper suportado.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do processo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "numero_processo": { "type": "string" },
                    "numero_formatado": { "type": "string" },
                    "tribunal": { "type": "string" },
                    "classe_codigo": { "type": "integer" },
                    "classe_nome": { "type": "string" },
                    "grau": { "type": "string" },
                    "data_ajuizamento": { "type": "string", "description": "Data ISO (YYYY-MM-DD)" },
                    "orgao_julgador": { "type": "string" },
                    "assuntos": { "type": "string" },
                    "valor_acao_num": { "type": "number", "nullable": true, "description": "Maior valor entre o valor declarado e os valores mencionados; null quando ausente" },
                    "valor_acao_formatado": { "type": "string", "nullable": true, "description": "valor_acao_num formatado em BRL; null quando ausente" },
                    "valores_mencionados": {
                      "type": "array",
                      "description": "Ate 20 valores monetarios mencionados (ordenados desc)",
                      "items": {
                        "type": "object",
                        "properties": {
                          "valor": { "type": "number" },
                          "formatado": { "type": "string", "description": "Valor formatado em BRL" },
                          "tipo": { "type": "string", "description": "Tipo do valor (slug)" }
                        }
                      }
                    },
                    "tags": {
                      "type": "array",
                      "description": "Tags brutas associadas ao processo",
                      "items": { "type": "string" }
                    },
                    "eventos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tipo": { "type": "string" },
                          "data": { "type": "string", "description": "Data ISO (YYYY-MM-DD)" }
                        }
                      }
                    },
                    "audiencias": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tipo": { "type": "string" },
                          "status": { "type": "string" },
                          "data": { "type": "string", "description": "Data ISO (YYYY-MM-DD)" }
                        }
                      }
                    },
                    "mandados": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tipo": { "type": "string" },
                          "data": { "type": "string", "description": "Data ISO (YYYY-MM-DD)" }
                        }
                      }
                    },
                    "bens": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "identificadores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tipo": { "type": "string" },
                          "valor": { "type": "string" }
                        }
                      }
                    },
                    "portes": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "partes": {
                      "type": "array",
                      "description": "Formato especifico deste endpoint (diverge da listagem por CPF/CNPJ).",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nome": { "type": "string", "description": "Nome da parte (Title Case)" },
                          "documento": { "type": "string", "nullable": true, "description": "CPF/CNPJ formatado; null quando ausente" },
                          "polo": { "type": "string", "description": "Polo em minusculas (ex: ativo, passivo)" },
                          "tipo": { "type": "string", "description": "Slug bruto do tipo (ex: pessoa_fisica, pessoa_juridica)" }
                        }
                      }
                    },
                    "advogados": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nome": { "type": "string" },
                          "oab": { "type": "string" },
                          "polo": { "type": "string", "description": "Polo em minusculas" },
                          "documento": { "type": "string", "description": "CPF formatado; string vazia (\"\") quando ausente" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "numero_processo": "00000012320208260100",
                  "numero_formatado": "0000001-23.2020.8.26.0100",
                  "tribunal": "tjsp",
                  "classe_codigo": 1234,
                  "classe_nome": "Procedimento Comum Cível",
                  "grau": "G1",
                  "data_ajuizamento": "2020-01-15",
                  "orgao_julgador": "1ª Vara Cível",
                  "assuntos": "Indenização por Dano Moral",
                  "valor_acao_num": 50000,
                  "valor_acao_formatado": "R$ 50.000",
                  "valores_mencionados": [
                    { "valor": 50000, "formatado": "R$ 50.000", "tipo": "causa" }
                  ],
                  "tags": ["evento.distribuicao", "porte.grande"],
                  "eventos": [
                    { "tipo": "distribuicao", "data": "2020-01-15" }
                  ],
                  "audiencias": [],
                  "mandados": [],
                  "bens": [],
                  "identificadores": [],
                  "portes": ["grande"],
                  "partes": [
                    { "nome": "João Silva", "documento": "123.456.789-01", "polo": "ativo", "tipo": "pessoa_fisica" },
                    { "nome": "Empresa X Ltda", "documento": "12.345.678/0001-99", "polo": "passivo", "tipo": "pessoa_juridica" }
                  ],
                  "advogados": [
                    { "nome": "José Advogado", "oab": "SP123456", "polo": "ativo", "documento": "987.654.321-00" }
                  ]
                }
              }
            }
          },
          "400": { "description": "Parametro invalido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Token ausente ou invalido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/processos/numero/{numero}/movimentacoes": {
      "get": {
        "operationId": "getMovimentacoesByNumero",
        "summary": "Lista movimentacoes de um processo",
        "description": "Retorna as movimentacoes mais recentes de um processo judicial, ordenadas por data (mais recentes primeiro). A listagem por CPF/CNPJ ja inclui ate 10 movimentacoes por processo; use este endpoint para obter ate 100 movimentacoes de um processo especifico.",
        "tags": ["Processos"],
        "parameters": [
          {
            "name": "numero",
            "in": "path",
            "required": true,
            "description": "Numero do processo (com ou sem formatacao)",
            "schema": { "type": "string", "example": "0000001-23.2020.8.26.0100" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximo de movimentacoes retornadas (default 20, maximo 100)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Movimentacoes do processo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "numero_processo": { "type": "string", "description": "Numero do processo (digitos)" },
                    "total": { "type": "integer", "description": "Total de movimentacoes retornadas (limitado pelo parametro `limit`)" },
                    "movimentacoes": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Movimentacao" }
                    }
                  }
                },
                "example": {
                  "numero_processo": "00000012320208260100",
                  "total": 3,
                  "movimentacoes": [
                    { "data": "2024-03-12", "descricao": "Decisao interlocutoria", "complemento": "Deferido pedido de tutela" },
                    { "data": "2024-02-28", "descricao": "Juntada de peticao", "complemento": "Manifestacao da parte autora" },
                    { "data": "2024-01-15", "descricao": "Distribuido por sorteio", "complemento": "1a Vara Civel" }
                  ]
                }
              }
            }
          },
          "400": { "description": "Numero de processo invalido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Token ausente ou invalido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/processos/categorias": {
      "get": {
        "operationId": "listCategorias",
        "summary": "Lista categorias de processos",
        "description": "Retorna todas as categorias disponiveis com totais de classes e processos. Use os slugs como valor do parametro `categorias` nos endpoints de CPF e CNPJ.",
        "tags": ["Categorias"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de categorias",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "categorias": [
                    { "slug": "recuperacao-judicial", "label": "Recuperacao Judicial", "total_classes": 3, "total_processos": 125000 },
                    { "slug": "falencia", "label": "Falencia / Insolvencia", "total_classes": 5, "total_processos": 450000 },
                    { "slug": "execucao-fiscal", "label": "Execucao Fiscal", "total_classes": 8, "total_processos": 5600000 },
                    { "slug": "execucao-civel", "label": "Execucao Civel", "total_classes": 6, "total_processos": 3200000 },
                    { "slug": "trabalhista", "label": "Trabalhista", "total_classes": 15, "total_processos": 8100000 },
                    { "slug": "criminal", "label": "Criminal", "total_classes": 30, "total_processos": 3200000 },
                    { "slug": "familia-sucessoes", "label": "Familia e Sucessoes", "total_classes": 12, "total_processos": 4500000 },
                    { "slug": "procedimento-comum", "label": "Procedimento Comum", "total_classes": 45, "total_processos": 12500000 },
                    { "slug": "juizado-especial", "label": "Juizado Especial", "total_classes": 8, "total_processos": 9800000 }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/processos/jobs/{jobId}": {
      "get": {
        "operationId": "getProcessosJobStatus",
        "summary": "Status do job de processos",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status do job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "description": "ID do job (UUID)"
                    },
                    "status": {
                      "type": "string",
                      "description": "Status atual do job",
                      "enum": ["waiting", "active", "completed", "failed"]
                    },
                    "created_at": {
                      "type": "integer",
                      "description": "Timestamp de criacao do job (epoch em milissegundos)"
                    },
                    "finished_at": {
                      "type": "integer",
                      "nullable": true,
                      "description": "Timestamp de conclusao (epoch em ms); presente quando status e completed ou failed"
                    },
                    "result": {
                      "type": "object",
                      "nullable": true,
                      "description": "Resultado do job quando status e completed (mesmo shape de /processos/cpf|cnpj)"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Mensagem de erro quando status e failed"
                    }
                  },
                  "example": {
                    "job_id": "3f1c2b6e-1a2b-4c3d-9e8f-0a1b2c3d4e5f",
                    "status": "completed",
                    "created_at": 1719500000000,
                    "finished_at": 1719500025000,
                    "result": {},
                    "error": null
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parametro invalido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou invalido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
