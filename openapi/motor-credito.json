    "/v1/operations/{id}": {
      "get": {
        "summary": "Consultar operação",
        "description": "Retorna o envelope de status da operação, sempre com todos os campos. O vocabulário de status é queued | processing | completed | failed. As contagens (tituloCount, approvedCount, blockedCount, alertCount) são null até completed; approvedCount + blockedCount + alertCount = tituloCount, e alertCount inclui os títulos com análise incompleta. completedAt só é preenchido em completed; error (string) só em failed, com estorno automático dos tokens. Não há header Retry-After: consulte a cada ~2 segundos. Quando completed, busque o resultado hierárquico em GET /v1/operations/{id}/result.",
        "operationId": "getOperation",
        "tags": ["Operações"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID da operação (campo operationId da resposta do POST)."
          },
          {
            "name": "x-request-id",
            "in": "header",
