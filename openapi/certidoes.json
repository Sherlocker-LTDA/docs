{
  "openapi": "3.0.0",
  "info": {
    "title": "Sherlocker Certidões API",
    "description": "Emissão assíncrona de comprovante cadastral CNPJ e Certidão de Débitos Trabalhistas, com JSON estruturado e evidência em PDF.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://221b-api.sherlocker.com.br/api/v1"
    }
  ],
  "security": [
    {
      "tokenAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "token"
      }
    },
    "schemas": {
      "CertidaoError": {
        "type": "object",
        "required": ["code", "category", "message", "retryable", "retry_after_seconds"],
        "properties": {
          "code": {
            "type": "string",
            "example": "FONTE_INDISPONIVEL"
          },
          "category": {
            "type": "string",
            "enum": ["validation", "business", "upstream", "integration", "integrity", "infrastructure", "configuration", "internal"]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_seconds": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CertidaoEvidence": {
        "type": "object",
        "required": ["status", "type", "mime_type", "pdf_url"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["available"]
          },
          "type": {
            "type": "string",
            "enum": ["official_certificate", "sherlocker_verification_report"]
          },
          "mime_type": {
            "type": "string",
            "enum": ["application/pdf"]
          },
          "sha256": {
            "type": "string"
          },
          "pdf_url": {
            "type": "string",
            "example": "/api/v1/certidoes/0d7c8a8a-74e1-42f3-a74b-ecf60568ff51/pdf"
          }
        }
      },
      "CertidaoEnvelope": {
        "type": "object",
        "required": ["certidao_id", "tipo", "status", "stage", "result", "evidence", "error", "links"],
        "properties": {
          "certidao_id": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "enum": ["cpf", "cnpj", "cndt", "nome"]
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"]
          },
          "stage": {
            "type": "string",
            "enum": ["waiting_worker", "accessing_source", "completed", "failed"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "evidence": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CertidaoEvidence"
              }
            ],
            "nullable": true
          },
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CertidaoError"
              }
            ],
            "nullable": true
          },
          "links": {
            "type": "object",
            "required": ["self", "pdf"],
            "properties": {
              "self": {
                "type": "string"
              },
              "pdf": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/certidoes/cpf": {
      "post": {
        "summary": "Inicia a emissão do comprovante cadastral CPF",
        "operationId": "emitirCertidaoCpf",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cpf"],
                "properties": {
                  "cpf": {
                    "type": "string",
                    "pattern": "^[0-9]{11}$",
                    "example": "52998224725"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Emissão enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertidaoEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "CPF inválido"
          },
          "422": {
            "description": "Dados cadastrais insuficientes para a consulta"
          }
        }
      }
    },
    "/certidoes/cnpj": {
      "post": {
        "summary": "Inicia a emissão do comprovante cadastral CNPJ",
        "operationId": "emitirCertidaoCnpj",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cnpj"],
                "properties": {
                  "cnpj": {
                    "type": "string",
                    "pattern": "^[0-9]{14}$",
                    "example": "11222333000181"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Emissão enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertidaoEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "CNPJ inválido"
          }
        }
      }
    },
    "/certidoes/trabalhista": {
      "post": {
        "summary": "Inicia a emissão da CNDT",
        "operationId": "emitirCertidaoTrabalhista",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["documento"],
                "properties": {
                  "documento": {
                    "type": "string",
                    "pattern": "^([0-9]{11}|[0-9]{14})$",
                    "example": "52998224725"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Emissão enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertidaoEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "CPF ou CNPJ inválido"
          }
        }
      }
    },
    "/certidoes/{certidaoId}": {
      "get": {
        "summary": "Consulta o estado e o resultado da emissão",
        "operationId": "consultarCertidao",
        "parameters": [
          {
            "name": "certidaoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado atual da emissão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertidaoEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Certidão inexistente ou pertencente a outra workspace"
          }
        }
      }
    },
    "/certidoes/{certidaoId}/pdf": {
      "get": {
        "summary": "Obtém a evidência PDF de uma emissão concluída",
        "operationId": "baixarPdfCertidao",
        "parameters": [
          {
            "name": "certidaoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirecionamento temporário para a evidência"
          },
          "404": {
            "description": "Certidão inexistente ou pertencente a outra workspace"
          },
          "409": {
            "description": "A emissão ainda não foi concluída"
          },
          "503": {
            "description": "Evidência temporariamente indisponível"
          }
        }
      }
    }
  }
}
